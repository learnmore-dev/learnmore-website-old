# =================================================================
# Learn More Technologies - Environment Configuration Example
# Copy this file to .env.local for local development or set in CI/CD
# =================================================================

# Canonical Base URL
NEXT_PUBLIC_SITE_URL=https://learnmoretechnologies.in

# WhatsApp & Phone Contact Configuration
NEXT_PUBLIC_DEFAULT_PHONE=+919036524555
NEXT_PUBLIC_MARATHAHALLI_WHATSAPP=919036524555
NEXT_PUBLIC_BTM_WHATSAPP=919036542555
NEXT_PUBLIC_KALYAN_NAGAR_WHATSAPP=919036354551

# Analytics & Tracking (Set real Measurement ID in AWS Amplify/Production environment)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification (HTML tag token from GSC property setup)
NEXT_PUBLIC_GSC_VERIFICATION=your_gsc_verification_token_here

# Environment Mode (development / staging / production)
NODE_ENV=production
